class Day {

  float procrasinatedHours;
  float sleptHours;
  float revisionHours;
  float gymHours;
  float travelHours;

  Day(float gaming, float sleeping, float studying, float gym, float travel) {

    procrasinatedHours = gaming;
    sleptHours = sleeping;
    revisionHours = studying;
    gymHours = gym;
    travelHours = travel;

  }
}
